// ============================================================
// TutioLMS — Prisma Schema (NestJS Backend Reference)
// PostgreSQL | Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  TEACHER
}

enum MaterialType {
  PDF
  NOTE
  VIDEO
}

enum StudentStatus {
  PENDING
  ACTIVE
  DISABLED
  REJECTED
}

// ─── Models ─────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt-hashed
  name      String
  phone     String?
  imageUrl  String?
  role      Role     @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials LearningMaterial[]

  @@map("users")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Institution {
  id        String         @id @default(uuid())
  name      String
  address   String
  phone     String
  mapUrl    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  timetable TimetableRow[]
  students  Student[]

  @@map("institutions")
}

model TimetableRow {
  id            String      @id @default(uuid())
  day           String
  time          String
  subject       String
  level         String      // "O/L" | "A/L"
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String

  @@map("timetable_rows")
}

model LearningMaterial {
  id         String       @id @default(uuid())
  title      String
  type       MaterialType
  content    String       @db.Text
  fileUrl    String?
  subject    String
  level      String       // "O/L" | "A/L"
  uploader   User         @relation(fields: [uploaderId], references: [id])
  uploaderId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("learning_materials")
}

model SiteSetting {
  key       String   @id    // e.g. "primaryHSL", "accentHSL", "navItems"
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ClassCategory {
  id          String      @id @default(uuid())
  label       String
  icon        String      @default("BookOpen")
  description String      @db.Text
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       ClassItem[]

  @@map("class_categories")
}

model ClassItem {
  id          String        @id @default(uuid())
  subject     String
  subjectCode String?
  level       String
  day         String
  time        String
  fee         String
  venue       String?
  seats       Int?
  notes       String?       @db.Text
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    ClassCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  students    Student[]

  @@map("class_items")
}

model Student {
  id              String        @id @default(uuid())
  email           String        @unique
  password        String
  name            String
  phone           String
  address         String
  examYear        String
  examLevel       String
  subject         String
  subjectCode     String
  institutionId   String?
  studentNumber   String        @unique
  status          StudentStatus @default(PENDING)
  profileImageUrl String?
  classItemId     String?
  classItem       ClassItem?    @relation(fields: [classItemId], references: [id], onDelete: SetNull)
  institution     Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  results         StudentResult[]

  @@map("students")
}

model ResultSheet {
  id             String          @id @default(uuid())
  title          String
  year           String
  examDate       String          @default("")
  description    String?
  gradeRanges    Json
  institutionIds Json
  results        StudentResult[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("result_sheets")
}

model StudentResult {
  id            String      @id @default(uuid())
  resultSheetId String
  resultSheet   ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mark          Float?
  grade         String?
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([resultSheetId, studentId])
  @@map("student_results")
}
