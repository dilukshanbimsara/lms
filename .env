# ─── Database ────────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials before running migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutiolms"

# ─── JWT (used by NestJS backend) ───────────────────────────────
JWT_SECRET="change-this-to-a-random-32-char-secret-in-production"
JWT_EXPIRES_IN="7d"

# ─── API Server (NestJS port) ───────────────────────────────────
PORT=4000

# ─── Next.js public API URL (used by frontend fetch calls) ──────
NEXT_PUBLIC_API_URL="http://localhost:4000"
